{
  "name": "@shoplex/frontend-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "node init && npm run dev --workspace=@shoplex/customer",
    "dev:seller": "node init && npm run dev --workspace=@shoplex/seller",
    "dev:admin": "node init && npm run dev --workspace=@shoplex/admin",
    "dev:manager": "node init && npm run dev --workspace=@shoplex/manager",
    "dev:owner": "node init && npm run dev --workspace=@shoplex/owner",
    "build:customer": "node init && npm run build --workspace=@shoplex/customer",
    "build:all": "node init && npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p apps/customer/tsconfig.json && tsc --noEmit -p apps/seller/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p apps/manager/tsconfig.json && tsc --noEmit -p apps/owner/tsconfig.json"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  }
}
